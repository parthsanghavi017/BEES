# Python caches
__pycache__/
*.py[cod]
*$py.class

# Databases & local storage
# clinical_pipeline.db is excluded but the encrypted evidence DB is bundled
*.sqlite
*.sqlite3
app/local_storage/vcfs/*
!app/local_storage/vcfs/.gitkeep
# Whitelist the bundled encrypted evidence database
!Var_DB/clinical_evidence.db

# Large clinical reference files & pre-existing databases

# Gene descriptions (ingested into SQLCipher DB via migrate_gene_descriptions.py)
Gene_Desc/

# Test / sample VCF files (internal only)
Test/

# Environment secrets — never commit actual credentials
.env
*.env.local

# Environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE configs
.vscode/
.idea/
.DS_Store

# Large gnomAD reference (too large for git — provide separately)
References/af-only-gnomad.hg38.vcf.gz
References/af-only-gnomad.hg38.vcf.gz.tbi
# Original unbranded .ser files (not distributed)
References/ensembl_91_hg38.ser
References/refseq_109_hg38.ser
# Whitelist BEES-branded annotation engine and databases
!bees-annotator.jar
!References/bees_ensembl_hg38.ser
!References/bees_refseq_hg38.ser

# Whitelist the bundled annotation engine components
!bin/.bees-core.jar
!bin/bees_annotator.py
