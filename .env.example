# BEES Environment Configuration Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-64-char-hex-string>

# ─── Encrypted Databases ───────────────────────────────────────────────────────
# Passphrase for Var_DB/clinical_evidence.db (SQLCipher AES-256)
SQLCIPHER_PASSPHRASE=<your-strong-passphrase-for-evidence-db>

# Passphrase for clinical_pipeline.db (SQLCipher AES-256)
CLINICAL_DB_PASSPHRASE=<your-strong-passphrase-for-case-db>
